# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to version control.

SECRET_KEY=change-me-to-a-long-random-string

# Leave the Stripe keys blank to run in DEMO_MODE (no real payments,
# donations are recorded locally). Fill them in once you have a
# Stripe account to switch on real test-mode payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: override the default SQLite file location
# DATABASE_URL=sqlite:///donations.db
